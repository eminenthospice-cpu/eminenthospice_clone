---
import { useTranslations, localizedPath, type Locale } from '../../i18n/utils';
import { BRAND, CONTACT, SITE } from '../../data/site-config';

interface Props {
  lang: Locale;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const t = useTranslations(lang);
const lp = (p: string) => localizedPath(p, lang);

const navLinks = [
  { href: lp('/'), label: t('nav.home') },
  { href: lp('/services'), label: t('nav.hospiceServices') },
  { href: lp('/understanding-hospice'), label: t('nav.understandingHospice') },
  { href: lp('/for-families'), label: t('nav.forFamilies') },
  { href: lp('/faq'), label: t('nav.faq') },
  { href: lp('/contact'), label: t('nav.contact') },
] as const;

const resourceLinks = [
  { href: lp('/insurance'), label: t('nav.insurance') },
  { href: lp('/hospice-laws'), label: t('nav.hospiceLaws') },
  { href: lp('/hipaa-notice'), label: t('footer.legalLinks.hipaaNotice') },
  { href: lp('/privacy'), label: t('footer.legalLinks.privacy') },
  { href: lp('/terms'), label: t('footer.legalLinks.terms') },
] as const;

const otherLang: Locale = lang === 'en' ? 'ko' : 'en';
const otherLangPath = currentPath === '/404'
  ? `/${otherLang}`
  : currentPath === '/' ? `/${otherLang}` : `/${otherLang}${currentPath}`;

function isActive(href: string): boolean {
  const clean = href.replace(/^\/en|^\/ko/, '');
  return clean === '' ? currentPath === '/' : currentPath.startsWith(clean || '/');
}

const resourcesActive = resourceLinks.some(({ href }) => isActive(href));
const isHomePage = currentPath === '/';
---

<header
  id="site-header"
  data-home-page={isHomePage ? 'true' : 'false'}
  class:list={[
    'sticky top-0 z-50 border-b border-line-hairline bg-white/95 backdrop-blur transition-shadow duration-300',
    { 'is-scrolled': !isHomePage },
  ]}
>
  <div id="quiet-brand-bar" class="container-wide flex h-[10.8rem] items-center justify-center transition-[height,opacity] duration-300">
    <a href={lp('/')} class="group inline-flex items-center justify-center text-center" aria-label={`${SITE.name} home`}>
      <img src={BRAND.logo} alt="" width="544" height="194" class="h-[8.1rem] w-[88vw] max-w-[30.6rem] shrink-0 object-contain transition-transform duration-300 group-hover:scale-105 sm:h-36 sm:w-[30.6rem]" loading="eager" decoding="async" />
    </a>
  </div>

  <div id="utility-bar" class="max-h-0 overflow-hidden bg-primary-900 text-white transition-[max-height] duration-300">
    <div class="container-wide flex min-h-11 items-center justify-between gap-3 py-1 text-sm">
      <a href={`tel:${CONTACT.phone.tel}`} class="inline-flex min-h-10 items-center gap-2 font-semibold text-white">
        <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 6.75z" />
        </svg>
        <span class="leading-tight">{lang === 'ko' ? '24시간' : '24/7'}: {CONTACT.phone.display}</span>
      </a>
      <a
        href={otherLangPath}
        hreflang={otherLang}
        class="inline-flex min-h-10 shrink-0 items-center whitespace-nowrap rounded-btn border border-white/40 px-2.5 text-caption font-semibold text-white hover:bg-white/10"
      >
        {otherLang === 'ko' ? '한국어' : 'English'}
      </a>
    </div>
  </div>

  <nav
    id="main-nav"
    aria-label={t('nav.mainNav')}
    class="container-wide grid max-h-0 grid-cols-[1fr_auto] items-center gap-4 overflow-hidden opacity-0 transition-[height,max-height,opacity] duration-300"
  >
    <a href={lp('/')} class="flex min-w-0 items-center justify-self-center py-1" aria-label={`${SITE.name} home`}>
      <img src={BRAND.logo} alt="" width="288" height="102" class="h-20 w-72 shrink-0 object-contain" loading="eager" decoding="async" />
    </a>

    <div class="flex items-center gap-2">
      <div class="hidden items-center gap-1 lg:flex">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class:list={[
              'inline-flex min-h-11 items-center rounded-btn px-3 text-base font-medium text-ink-700 hover:bg-primary-50 hover:text-primary-800',
              { 'bg-primary-50 text-primary-800': isActive(href) },
            ]}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
          </a>
        ))}

        <div class="group relative" id="resources-menu">
          <button
            type="button"
            id="resources-menu-btn"
            class:list={[
              'inline-flex min-h-11 items-center gap-1 rounded-btn px-3 text-base font-medium text-ink-700 hover:bg-primary-50 hover:text-primary-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500',
              { 'bg-primary-50 text-primary-800': resourcesActive },
            ]}
            aria-haspopup="true"
            aria-expanded="false"
          >
            {t('nav.resources')}
            <svg aria-hidden="true" class="h-4 w-4 transition-transform duration-150 group-hover:rotate-180 group-focus-within:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
            </svg>
          </button>
          <div id="resources-menu-panel" class="invisible absolute right-0 top-full z-50 w-72 pt-2 opacity-0 transition-[opacity,visibility] duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
            <div class="rounded-card border border-line-soft bg-white p-2 shadow-float">
              {resourceLinks.map(({ href, label }) => (
                <a
                  href={href}
                  class:list={[
                    'block rounded-btn px-3 py-2.5 text-base font-medium leading-snug text-ink-700 hover:bg-primary-50 hover:text-primary-800',
                    { 'bg-primary-50 text-primary-800': isActive(href) },
                  ]}
                >
                  {label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <a
        href={lp('/referral')}
        class="hidden min-h-11 items-center justify-center rounded-btn bg-primary-700 px-4 text-base font-semibold text-white shadow-card hover:bg-primary-800 sm:inline-flex"
      >
        {t('nav.referral')}
      </a>
      <button
        id="mobile-menu-btn"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-btn border border-line-soft text-ink-800 lg:hidden"
        aria-label={t('nav.openMenu')}
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <svg id="icon-menu" aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="icon-close" aria-hidden="true" class="hidden h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-drawer" class="hidden border-t border-line-hairline bg-white lg:hidden">
    <nav aria-label={t('nav.mobileNav')} class="container-wide grid gap-1 py-4">
      {navLinks.map(({ href, label }) => (
        <a href={href} class="rounded-btn px-3 py-3 text-lg font-medium text-ink-800 hover:bg-primary-50">
          {label}
        </a>
      ))}
      <div class="mt-2 border-t border-line-hairline pt-3">
        <p class="px-3 pb-1 text-sm font-semibold uppercase text-ink-500">{t('nav.resources')}</p>
        <div class="grid gap-1">
          {resourceLinks.map(({ href, label }) => (
            <a href={href} class="rounded-btn px-3 py-2.5 text-base font-medium text-ink-700 hover:bg-primary-50">
              {label}
            </a>
          ))}
        </div>
      </div>
      <div class="mt-3 grid gap-2 border-t border-line-hairline pt-4">
        <a href={`tel:${CONTACT.phone.tel}`} class="rounded-btn bg-accent-gold-500 px-4 py-3 text-center text-lg font-semibold text-ink-900">
          {lang === 'ko' ? '24시간 전화' : 'Call 24/7'} {CONTACT.phone.display}
        </a>
        <a href={lp('/referral')} class="rounded-btn bg-primary-700 px-4 py-3 text-center text-lg font-semibold text-white shadow-card hover:bg-primary-800">
          {t('nav.referral')}
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  #site-header.is-scrolled {
    box-shadow: 0 1px 0 0 rgb(0 0 0 / 0.06);
  }

  #main-nav {
    height: 0;
  }

  #site-header.is-scrolled #quiet-brand-bar {
    height: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
  }

  #site-header.is-scrolled #utility-bar {
    max-height: 4rem;
  }

  #site-header.is-scrolled #main-nav {
    height: 5.75rem;
    max-height: 6.5rem;
    overflow: visible;
    opacity: 1;
  }

  #resources-menu.is-open #resources-menu-panel {
    visibility: visible;
    opacity: 1;
  }

  @media (max-width: 420px) {
    #quiet-brand-bar {
      height: 8.1rem;
    }

    #quiet-brand-bar img {
      height: 6.75rem;
      width: 88vw;
      max-width: 25.2rem;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  const SCROLL_AT = 36;
  const isHomePage = header?.dataset.homePage === 'true';
  let introConsumed = !isHomePage;
  let scrolled = header?.classList.contains('is-scrolled') ?? false;
  let ticking = false;

  function applyHeaderState() {
    if (isHomePage && !introConsumed && window.scrollY > SCROLL_AT) {
      introConsumed = true;
    }

    const next = !isHomePage || introConsumed || window.scrollY > SCROLL_AT;
    if (next !== scrolled) {
      scrolled = next;
      header?.classList.toggle('is-scrolled', scrolled);
    }
    ticking = false;
  }

  function requestHeaderState() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(applyHeaderState);
    }
  }

  function setOpen(open) {
    btn?.setAttribute('aria-expanded', open ? 'true' : 'false');
    drawer?.classList.toggle('hidden', !open);
    iconMenu?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    if (open) {
      introConsumed = true;
      applyHeaderState();
    }
  }

  applyHeaderState();
  window.addEventListener('scroll', requestHeaderState, { passive: true });

  btn?.addEventListener('click', () => {
    setOpen(btn.getAttribute('aria-expanded') !== 'true');
  });

  drawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });

  const resourcesMenu = document.getElementById('resources-menu');
  const resourcesBtn = document.getElementById('resources-menu-btn');
  if (resourcesMenu && resourcesBtn) {
    let resourcesPinned = false;
    const setResourcesExpanded = (open) => {
      resourcesBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      resourcesMenu.classList.toggle('is-open', open);
    };
    resourcesMenu.addEventListener('mouseenter', () => setResourcesExpanded(true));
    resourcesMenu.addEventListener('mouseleave', () => {
      if (!resourcesPinned) setResourcesExpanded(false);
    });
    resourcesBtn.addEventListener('click', (event) => {
      event.stopPropagation();
      const next = !resourcesPinned || resourcesBtn.getAttribute('aria-expanded') !== 'true';
      resourcesPinned = next;
      setResourcesExpanded(next);
    });
    resourcesMenu.addEventListener('focusin', () => setResourcesExpanded(true));
    resourcesMenu.addEventListener('focusout', (event) => {
      if (!resourcesPinned && !resourcesMenu.contains(event.relatedTarget)) setResourcesExpanded(false);
    });
    document.addEventListener('click', (event) => {
      if (!resourcesMenu.contains(event.target)) {
        resourcesPinned = false;
        setResourcesExpanded(false);
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        resourcesPinned = false;
        setResourcesExpanded(false);
      }
    });
  }
</script>
