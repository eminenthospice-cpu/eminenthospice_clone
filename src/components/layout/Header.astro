---
import { useTranslations, localizedPath, type Locale } from '../../i18n/utils';
import { BRAND, CONTACT, SITE } from '../../data/site-config';

interface Props {
  lang: Locale;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const t = useTranslations(lang);
const lp = (p: string) => localizedPath(p, lang);

const navLinks = [
  { href: lp('/'), label: t('nav.home') },
  { href: lp('/services'), label: t('nav.hospiceServices') },
  { href: lp('/understanding-hospice'), label: lang === 'ko' ? '진행 과정' : 'What to Expect' },
  { href: lp('/for-families'), label: t('nav.forFamilies') },
  { href: lp('/faq'), label: t('nav.faq') },
  { href: lp('/contact'), label: t('nav.contact') },
] as const;

const otherLang: Locale = lang === 'en' ? 'ko' : 'en';
const otherLangPath = currentPath === '/404'
  ? `/${otherLang}`
  : currentPath === '/' ? `/${otherLang}` : `/${otherLang}${currentPath}`;

function isActive(href: string): boolean {
  const clean = href.replace(/^\/en|^\/ko/, '');
  return clean === '' ? currentPath === '/' : currentPath.startsWith(clean || '/');
}

const isHomePage = currentPath === '/';
---

<header
  id="site-header"
  data-home-page={isHomePage ? 'true' : 'false'}
  class:list={[
    'sticky top-0 z-50 border-b border-line-hairline bg-white/95 backdrop-blur transition-shadow duration-300',
    { 'is-scrolled': !isHomePage },
  ]}
>
  <div id="quiet-brand-bar" class="container-wide flex h-24 items-center justify-center transition-all duration-300">
    <a href={lp('/')} class="group inline-flex items-center gap-4 text-center" aria-label={`${SITE.name} home`}>
      <img src={BRAND.logo} alt="" width="56" height="56" class="h-14 w-14 shrink-0 object-contain transition-transform duration-300 group-hover:scale-105" loading="eager" decoding="async" />
      <span>
        <span class="block font-heading text-4xl font-semibold leading-none text-ink-900 sm:text-5xl">
          Eminent Hospice
        </span>
        <span class="mt-2 block text-base font-medium tracking-wide text-primary-700">
          {lang === 'ko' ? 'Comfort. Dignity. Compassion.' : 'Comfort. Dignity. Compassion.'}
        </span>
      </span>
    </a>
  </div>

  <div id="utility-bar" class="max-h-0 overflow-hidden bg-primary-900 text-white transition-all duration-300">
    <div class="container-wide flex min-h-11 items-center justify-between gap-3 py-1 text-sm">
      <a href={`tel:${CONTACT.phone.tel}`} class="inline-flex min-h-10 items-center gap-2 font-semibold text-white">
        <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 6.75z" />
        </svg>
        <span class="leading-tight">{lang === 'ko' ? '24시간' : '24/7'}: {CONTACT.phone.display}</span>
      </a>
      <a
        href={otherLangPath}
        hreflang={otherLang}
        class="inline-flex min-h-10 shrink-0 items-center whitespace-nowrap rounded-btn border border-white/40 px-2.5 text-caption font-semibold text-white hover:bg-white/10"
      >
        {otherLang === 'ko' ? '한국어' : 'English'}
      </a>
    </div>
  </div>

  <nav
    id="main-nav"
    aria-label={t('nav.mainNav')}
    class="container-wide grid max-h-0 grid-cols-[1fr_auto] items-center gap-4 overflow-hidden opacity-0 transition-all duration-300"
  >
    <a href={lp('/')} class="flex min-w-0 items-center gap-3 py-3" aria-label={`${SITE.name} home`}>
      <img src={BRAND.logo} alt="" width="44" height="44" class="h-11 w-11 shrink-0 object-contain" loading="eager" decoding="async" />
      <span class="min-w-0">
        <span class="block truncate text-lg font-bold leading-tight text-ink-900">{SITE.name}</span>
        <span class="hidden text-caption leading-tight text-ink-500 sm:block">{SITE.tagline}</span>
      </span>
    </a>

    <div class="flex items-center gap-2">
      <div class="hidden items-center gap-1 lg:flex">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class:list={[
              'inline-flex min-h-11 items-center rounded-btn px-3 text-base font-medium text-ink-700 hover:bg-primary-50 hover:text-primary-800',
              { 'bg-primary-50 text-primary-800': isActive(href) },
            ]}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
          </a>
        ))}
      </div>

      <a
        href={lp('/referral')}
        class="hidden min-h-11 items-center justify-center rounded-btn bg-accent-gold-500 px-4 text-base font-semibold text-ink-900 hover:bg-accent-gold-400 sm:inline-flex"
      >
        {t('nav.referral')}
      </a>
      <button
        id="mobile-menu-btn"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-btn border border-line-soft text-ink-800 lg:hidden"
        aria-label={t('nav.openMenu')}
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <svg id="icon-menu" aria-hidden="true" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="icon-close" aria-hidden="true" class="hidden h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-drawer" class="hidden border-t border-line-hairline bg-white lg:hidden">
    <nav aria-label={t('nav.mobileNav')} class="container-wide grid gap-1 py-4">
      {navLinks.map(({ href, label }) => (
        <a href={href} class="rounded-btn px-3 py-3 text-lg font-medium text-ink-800 hover:bg-primary-50">
          {label}
        </a>
      ))}
      <div class="mt-3 grid gap-2 border-t border-line-hairline pt-4">
        <a href={`tel:${CONTACT.phone.tel}`} class="rounded-btn bg-primary-700 px-4 py-3 text-center text-lg font-semibold text-white">
          {lang === 'ko' ? '24시간 전화' : 'Call 24/7'} {CONTACT.phone.display}
        </a>
        <a href={lp('/referral')} class="rounded-btn bg-accent-gold-500 px-4 py-3 text-center text-lg font-semibold text-ink-900">
          {t('nav.referral')}
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  #site-header.is-scrolled {
    box-shadow: 0 1px 0 0 rgb(0 0 0 / 0.06);
  }

  #main-nav {
    height: 0;
  }

  #site-header.is-scrolled #quiet-brand-bar {
    height: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
  }

  #site-header.is-scrolled #utility-bar {
    max-height: 4rem;
  }

  #site-header.is-scrolled #main-nav {
    height: 4.25rem;
    max-height: 5.5rem;
    opacity: 1;
  }

  @media (max-width: 420px) {
    #quiet-brand-bar {
      height: 5.5rem;
    }

    #quiet-brand-bar .font-heading {
      font-size: 2.2rem;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  const SCROLL_AT = 36;
  const isHomePage = header?.dataset.homePage === 'true';
  let introConsumed = !isHomePage;
  let scrolled = header?.classList.contains('is-scrolled') ?? false;
  let ticking = false;

  function applyHeaderState() {
    if (isHomePage && !introConsumed && window.scrollY > SCROLL_AT) {
      introConsumed = true;
    }

    const next = !isHomePage || introConsumed || window.scrollY > SCROLL_AT;
    if (next !== scrolled) {
      scrolled = next;
      header?.classList.toggle('is-scrolled', scrolled);
    }
    ticking = false;
  }

  function requestHeaderState() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(applyHeaderState);
    }
  }

  function setOpen(open) {
    btn?.setAttribute('aria-expanded', open ? 'true' : 'false');
    drawer?.classList.toggle('hidden', !open);
    iconMenu?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    if (open) {
      introConsumed = true;
      applyHeaderState();
    }
  }

  applyHeaderState();
  window.addEventListener('scroll', requestHeaderState, { passive: true });

  btn?.addEventListener('click', () => {
    setOpen(btn.getAttribute('aria-expanded') !== 'true');
  });

  drawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });
</script>
