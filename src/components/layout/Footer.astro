---
import { useTranslations, localizedPath } from '../../i18n/utils';
import { CONTACT } from '../../data/site-config';

export interface Props {
  lang: 'en' | 'ko';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const lp = (p: string) => localizedPath(p, lang);

const primaryLinks = [
  { label: t('footer.home'), href: lp('/') },
  { label: t('footer.hospiceServices'), href: lp('/services') },
  { label: t('nav.understandingHospice'), href: lp('/understanding-hospice') },
  { label: t('footer.faq'), href: lp('/faq') },
  { label: t('footer.contact'), href: lp('/contact') },
  { label: t('footer.referral'), href: lp('/referral') },
] as const;

const resourceLinks = [
  { label: t('nav.insurance'), href: lp('/insurance') },
  { label: t('nav.hospiceLaws'), href: lp('/hospice-laws') },
  { label: t('footer.legalLinks.hipaaNotice'), href: lp('/hipaa-notice') },
  { label: t('footer.legalLinks.privacy'), href: lp('/privacy') },
  { label: t('footer.legalLinks.terms'), href: lp('/terms') },
] as const;

const legalLinks = [
  { label: t('footer.legalLinks.accessibility'), href: lp('/accessibility') },
  { label: t('footer.legalLinks.sitemap') || 'Sitemap', href: '/sitemap-index.xml' },
] as const;

const year = new Date().getFullYear();
const copyright = t('footer.copyright').replace('{year}', String(year));
---

<footer class="border-t border-line-hairline bg-primary-900 text-white">
  <div class="container-wide py-12">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.85fr_0.95fr_1fr]">
      <div>
        <h2 class="text-2xl font-bold leading-tight">Eminent Hospice Care</h2>
        <p class="mt-3 max-w-md text-base leading-relaxed text-primary-100">{t('footer.tagline')}</p>
        <a href={`tel:${CONTACT.phone.tel}`} class="mt-6 inline-flex rounded-btn bg-accent-gold-500 px-5 py-3 font-semibold text-ink-900 hover:bg-accent-gold-400">
          {lang === 'ko' ? '24시간 전화' : 'Call 24/7'} {CONTACT.phone.display}
        </a>
      </div>

      <nav aria-label={t('footer.footerNav')}>
        <h3 class="text-sm font-semibold uppercase text-primary-200">{t('footer.quickLinksHeading')}</h3>
        <ul class="mt-4 grid gap-2">
          {primaryLinks.map(({ label, href }) => (
            <li>
              <a href={href} class="inline-flex min-h-10 items-center text-base text-primary-100 hover:text-white">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t('nav.resources')}>
        <h3 class="text-sm font-semibold uppercase text-primary-200">{t('nav.resources')}</h3>
        <ul class="mt-4 grid gap-2">
          {resourceLinks.map(({ label, href }) => (
            <li>
              <a href={href} class="inline-flex min-h-10 items-center text-base text-primary-100 hover:text-white">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h3 class="text-sm font-semibold uppercase text-primary-200">{t('footer.contactHeading')}</h3>
        <address class="mt-4 space-y-3 not-italic text-base leading-relaxed text-primary-100">
          <p>{CONTACT.address.display}</p>
          <p><a href={`tel:${CONTACT.phone.tel}`} class="hover:text-white">{CONTACT.phone.display}</a></p>
          <p><a href={`mailto:${CONTACT.email}`} class="break-all hover:text-white">{CONTACT.email}</a></p>
          <p>{CONTACT.hours}</p>
        </address>
      </div>
    </div>

    <div class="mt-10 border-t border-white/10 pt-6">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-caption text-primary-200">
        {legalLinks.map(({ label, href }) => (
          <li><a href={href} class="hover:text-white">{label}</a></li>
        ))}
      </ul>
      <div class="mt-5 flex flex-col gap-2 text-caption text-primary-300 sm:flex-row sm:justify-between">
        <p>{copyright}</p>
        <p>{t('footer.licensedInCalifornia')}</p>
      </div>
    </div>
  </div>
</footer>
