---
/**
 * PageSidebar.astro - Sticky TOC + related-page links for content pages.
 */
import { localizedPath } from '../../i18n/utils';

export interface Anchor {
  id: string;
  label: string;
}

export interface RelatedLink {
  href: string;
  label: string;
}

export interface Props {
  anchors: Anchor[];
  relatedLinks?: RelatedLink[];
  lang: 'en' | 'ko';
}

const { anchors, relatedLinks = [], lang } = Astro.props;
const onThisPage = lang === 'ko' ? '이 페이지에서' : 'On this page';
const relatedTitle = lang === 'ko' ? '관련 페이지' : 'Related pages';
const cleanLabel = (label: string) => label.replace(/\s+\u2014\s+/g, ': ').replace(/\u2014/g, ':');
---

<nav aria-label={onThisPage} class="sticky top-44 space-y-7">
  <div>
    <p class="eyebrow text-primary-700 mb-3">{onThisPage}</p>
    <ul class="space-y-2">
      {anchors.map(({ id, label }) => (
        <li>
          <a
            href={`#${id}`}
            class="block rounded-btn border border-line-soft bg-white px-3.5 py-2.5 text-body-sm font-medium leading-snug text-ink-700 shadow-card transition-[background-color,border-color,color,box-shadow] duration-100 hover:border-primary-300 hover:bg-primary-50 hover:text-primary-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
          >
            {cleanLabel(label)}
          </a>
        </li>
      ))}
    </ul>
  </div>

  {relatedLinks.length > 0 && (
    <div>
      <p class="eyebrow text-ink-400 mb-3">{relatedTitle}</p>
      <ul class="space-y-2">
        {relatedLinks.map(({ href, label }) => (
          <li>
            <a
              href={localizedPath(href, lang)}
              class="block rounded-btn border border-line-hairline bg-surface-canvas px-3.5 py-2.5 text-body-sm font-medium leading-snug text-ink-600 transition-[background-color,border-color,color] duration-100 hover:border-primary-200 hover:bg-white hover:text-primary-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
            >
              {cleanLabel(label)}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</nav>
