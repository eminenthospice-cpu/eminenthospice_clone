---
import { useTranslations, localizedPath } from '../../i18n/utils';
import { CONTACT } from '../../data/site-config';

export interface Props {
  lang: 'en' | 'ko';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const lp = (p: string) => localizedPath(p, lang);

const actions = [
  {
    href: `tel:${CONTACT.phone.tel}`,
    title: t('home.quickActions.call.title'),
    body: t('home.quickActions.call.body'),
    primary: true,
    icon: 'phone',
  },
  {
    href: lp('/referral'),
    title: t('home.quickActions.referral.title'),
    body: t('home.quickActions.referral.body'),
    icon: 'clipboard',
  },
  {
    href: lp('/contact'),
    title: t('home.quickActions.question.title'),
    body: t('home.quickActions.question.body'),
    icon: 'message',
  },
] as const;
---

<section aria-label={t('home.quickActions.ariaLabel')} class="border-y border-line-hairline bg-surface-canvas">
  <div class="container-wide grid gap-3 py-5 md:grid-cols-3">
    {actions.map((action) => (
      <a
        href={action.href}
        class:list={[
          'group flex min-h-[112px] items-center gap-4 rounded-card border px-5 py-4 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500',
          action.primary
            ? 'border-primary-700 bg-primary-700 text-white hover:bg-primary-800'
            : 'border-line-hairline bg-white text-ink-900 hover:border-primary-200 hover:bg-primary-50',
        ]}
      >
        <span class:list={[
          'flex h-11 w-11 shrink-0 items-center justify-center rounded-full',
          action.primary ? 'bg-white/15 text-white' : 'bg-primary-50 text-primary-700',
        ]}>
          {action.icon === 'phone' && (
            <svg aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 6.75z" />
            </svg>
          )}
          {action.icon === 'clipboard' && (
            <svg aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m-7.5-12h3l.75-1.5h3L15 4h3a1.5 1.5 0 0 1 1.5 1.5v14A1.5 1.5 0 0 1 18 21H6a1.5 1.5 0 0 1-1.5-1.5v-14A1.5 1.5 0 0 1 6 4h1.5z" />
            </svg>
          )}
          {action.icon === 'message' && (
            <svg aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm3.75 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm3.75 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12c0 4.142-4.03 7.5-9 7.5a10.7 10.7 0 0 1-3.75-.66L3 20.25l1.67-4A6.76 6.76 0 0 1 3 12c0-4.142 4.03-7.5 9-7.5s9 3.358 9 7.5Z" />
            </svg>
          )}
        </span>
        <span>
          <span class="block text-lg font-semibold leading-tight">{action.title}</span>
          <span class:list(['mt-1 block text-base leading-snug', action.primary ? 'text-primary-100' : 'text-ink-600'])}>{action.body}</span>
        </span>
      </a>
    ))}
  </div>
</section>
