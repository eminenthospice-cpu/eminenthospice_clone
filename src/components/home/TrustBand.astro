---
import { useTranslations } from '../../i18n/utils';

export interface Props {
  lang: 'en' | 'ko';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const items = ['medicare', 'joint', 'bilingual', 'local'] as const;
---

<section aria-labelledby="trust-heading" class="bg-white text-ink-900">
  <div class="container-wide py-14">
    <div class="reveal rounded-card border border-primary-100 bg-primary-50 p-6 shadow-soft md:p-8">
      <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:items-center">
        <div>
          <p class="eyebrow mb-3 inline-flex rounded-btn bg-white px-3 py-2 text-primary-700 shadow-card">{t('home.trust.eyebrow')}</p>
          <h2 id="trust-heading" class="font-prose text-3xl leading-tight text-ink-900 md:text-4xl">{t('home.trust.title')}</h2>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {items.map((item, index) => (
            <div class:list={[
              'rounded-card border p-5 shadow-card',
              index === 0 ? 'border-primary-100 bg-white' :
              index === 1 ? 'border-accent-gold-100 bg-accent-gold-50' :
              index === 2 ? 'border-accent-sage-100 bg-accent-sage-50' :
              'border-primary-100 bg-white',
            ]}>
              <p class="text-lg font-semibold leading-tight text-primary-900">{t(`home.trust.items.${item}.title`)}</p>
              <p class="mt-2 text-base leading-relaxed text-ink-700">{t(`home.trust.items.${item}.body`)}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
