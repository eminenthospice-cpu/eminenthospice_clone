---
import { useTranslations } from '../../i18n/utils';
import SectionContainer from '../ui/SectionContainer.astro';
import en from '../../i18n/en.json';
import ko from '../../i18n/ko.json';

export interface Props {
  lang: 'en' | 'ko';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

interface TestimonialItem {
  quote: string;
  name: string;
  relation: string;
  rating?: number;
}

const data = lang === 'ko' ? ko : en;
const testimonials = data.home.testimonials.items as TestimonialItem[];
---

<SectionContainer bg="white" ariaLabelledBy="quote-heading">
  <div class="reveal mx-auto max-w-6xl">
    <p class="eyebrow mb-4 text-primary-700 text-center">{t('home.testimonials.eyebrow')}</p>
    <h2 id="quote-heading" class="font-heading text-3xl text-ink-900 md:text-4xl mb-10 text-center">
      {t('home.testimonials.heading')}
    </h2>

    <div class="testimonial-carousel">
      <div class="testimonial-track">
        {[0, 1].map((copyIndex) => (
          <div class="testimonial-set" aria-hidden={copyIndex === 1 ? 'true' : undefined}>
            {testimonials.map((item) => (
              <figure class="testimonial-slide rounded-card border border-line-hairline bg-surface-canvas p-8 md:p-10">
                {item.rating && (
                  <div class="mb-4 flex gap-1 text-accent-gold-500" aria-hidden="true">
                    {Array.from({ length: 5 }).map((_, starIndex) => (
                      <svg viewBox="0 0 20 20" class="h-5 w-5" fill={starIndex < item.rating! ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.25">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.8L10 14.9l-5.2 2.72.99-5.8-4.21-4.1 5.82-.85L10 1.5z" />
                      </svg>
                    ))}
                  </div>
                )}
                <blockquote class="font-prose text-xl leading-relaxed text-ink-900 md:text-2xl">
                  &ldquo;{item.quote}&rdquo;
                </blockquote>
                <figcaption class="mt-6 text-base font-semibold text-ink-700">
                  {item.name}
                  <span class="font-normal text-ink-500"> — {item.relation}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</SectionContainer>

<style>
  .testimonial-carousel {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
  }
  .testimonial-track {
    display: flex;
    width: max-content;
    gap: 1.5rem;
    animation: testimonial-loop 45s linear infinite;
  }
  .testimonial-set {
    display: flex;
    gap: 1.5rem;
  }
  .testimonial-slide {
    flex: 0 0 min(82vw, 34rem);
  }

  @keyframes testimonial-loop {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 0.75rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonial-track {
      animation: none;
      display: block;
      width: auto;
    }
    .testimonial-set {
      display: grid;
      gap: 1rem;
    }
    .testimonial-set[aria-hidden='true'] {
      display: none;
    }
    .testimonial-slide {
      width: auto;
    }
  }
</style>
