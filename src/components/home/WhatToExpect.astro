---
import { useTranslations } from '../../i18n/utils';
import SectionContainer from '../ui/SectionContainer.astro';

export interface Props {
  lang: 'en' | 'ko';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const steps = ['call', 'review', 'visit'] as const;
---

<SectionContainer bg="white" ariaLabelledBy="expect-heading">
  <div class="reveal mx-auto max-w-3xl text-center">
    <p class="eyebrow mb-3 text-primary-700">{t('home.expect.eyebrow')}</p>
    <h2 id="expect-heading" class="font-heading text-4xl leading-tight text-ink-900 md:text-5xl">
      {t('home.expect.title')}
    </h2>
    <p class="mt-4 text-lg leading-relaxed text-ink-700">{t('home.expect.subtitle')}</p>
  </div>

  <div class="mt-12 grid gap-4 md:grid-cols-3">
    {steps.map((step, index) => (
      <article class="reveal rounded-card border border-line-hairline bg-surface-canvas p-6">
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-primary-700 text-base font-bold text-white">
          {index + 1}
        </span>
        <h3 class="mt-5 text-xl font-semibold leading-tight text-ink-900">{t(`home.expect.steps.${step}.title`)}</h3>
        <p class="mt-3 text-base leading-relaxed text-ink-700">{t(`home.expect.steps.${step}.body`)}</p>
      </article>
    ))}
  </div>
</SectionContainer>
