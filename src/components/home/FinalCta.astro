---
import { useTranslations, localizedPath } from '../../i18n/utils';
import { CONTACT } from '../../data/site-config';
import Button from '../ui/Button.astro';

export interface Props {
  lang: 'en' | 'ko';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const lp = (p: string) => localizedPath(p, lang);
---

<section aria-labelledby="final-cta-heading" class="bg-white">
  <div class="container-wide pb-20">
    <div class="reveal rounded-card border border-primary-100 bg-primary-50 px-6 py-10 text-center text-ink-900 shadow-soft md:px-12 md:py-14">
      <p class="eyebrow mb-3 text-primary-700">{t('home.finalCta.eyebrow')}</p>
      <h2 id="final-cta-heading" class="mx-auto max-w-3xl font-prose text-4xl leading-tight text-ink-900 md:text-5xl">
        {t('home.finalCta.title')}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-ink-700">{t('home.finalCta.subtitle')}</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <Button href={`tel:${CONTACT.phone.tel}`} variant="gold" size="xl">
          <svg aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 6.75z" />
          </svg>
          {t('home.finalCta.call')} {CONTACT.phone.display}
        </Button>
        <Button href={lp('/referral')} variant="secondary" size="xl">
          {t('home.finalCta.refer')}
        </Button>
      </div>
    </div>
  </div>
</section>
