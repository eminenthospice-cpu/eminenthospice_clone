---
import LongFormLayout from '../../layouts/LongFormLayout.astro';
import PageSidebar from '../../components/layout/PageSidebar.astro';
import FaqPageJsonLd from '../../components/seo/FaqPageJsonLd.astro';
import { localizedPath } from '../../i18n/utils';
import { VIDEO_RESOURCES } from '../../data/videos';
import koData from '../../i18n/ko.json';

const lang = 'ko' as const;
const lp = (p: string) => localizedPath(p, lang);
const d = koData.faq;
const common = koData.common;

const catOrder = ['gettingStarted', 'aboutHospice', 'insurance', 'families', 'rights'] as const;
const catAnchors: Record<string, string> = {
  gettingStarted: 'getting-started',
  aboutHospice:   'about-hospice',
  insurance:      'insurance',
  families:       'families',
  rights:         'rights',
};

const anchors = [
  { id: 'video-library', label: '동영상 모음' },
  ...catOrder.map(key => ({
    id: catAnchors[key],
    label: d.categories[key].title,
  })),
];

const relatedLinks = [
  { href: '/understanding-hospice', label: common.relatedPages.links.understandingHospice },
  { href: '/insurance',             label: common.relatedPages.links.insurance },
  { href: '/hospice-laws',          label: common.relatedPages.links.hospiceLaws },
  { href: '/contact',               label: common.relatedPages.links.contact },
];

const faqJsonLdItems = catOrder.flatMap(catKey =>
  Object.values(d.categories[catKey].items).map(item => ({
    question: item.q,
    answer: item.a,
  }))
);

const categoryStyles = {
  gettingStarted: {
    heading: 'border-primary-100 bg-primary-50 text-primary-900',
    dot: 'bg-primary-500',
    details: 'border-primary-200 bg-primary-50',
    summary: 'text-primary-900 hover:bg-primary-100',
    icon: 'text-primary-700',
    panel: 'border-primary-200 bg-white',
  },
  aboutHospice: {
    heading: 'border-accent-gold-100 bg-accent-gold-50 text-accent-gold-900',
    dot: 'bg-accent-gold-500',
    details: 'border-accent-gold-200 bg-accent-gold-50',
    summary: 'text-accent-gold-900 hover:bg-accent-gold-100',
    icon: 'text-accent-gold-700',
    panel: 'border-accent-gold-200 bg-white',
  },
  insurance: {
    heading: 'border-accent-sage-100 bg-accent-sage-50 text-accent-sage-900',
    dot: 'bg-accent-sage-500',
    details: 'border-accent-sage-200 bg-accent-sage-50',
    summary: 'text-accent-sage-900 hover:bg-accent-sage-100',
    icon: 'text-accent-sage-700',
    panel: 'border-accent-sage-200 bg-white',
  },
  families: {
    heading: 'border-primary-100 bg-white text-primary-900',
    dot: 'bg-primary-500',
    details: 'border-line-soft bg-white',
    summary: 'text-primary-900 hover:bg-primary-50',
    icon: 'text-primary-700',
    panel: 'border-line-soft bg-white',
  },
  rights: {
    heading: 'border-accent-gold-100 bg-white text-accent-gold-900',
    dot: 'bg-accent-gold-500',
    details: 'border-accent-gold-100 bg-white',
    summary: 'text-accent-gold-900 hover:bg-accent-gold-50',
    icon: 'text-accent-gold-700',
    panel: 'border-accent-gold-100 bg-white',
  },
} as const;
---

<LongFormLayout
  title={d.pageTitle}
  description={d.metaDescription}
  lang={lang}
  path="/faq"
  eyebrow="자주 묻는 질문"
  introParagraph={d.introParagraph}
  lastReviewed={d.lastReviewed}
>
  <FaqPageJsonLd slot="head" items={faqJsonLdItems} />

  <PageSidebar slot="sidebar" {anchors} {relatedLinks} {lang} />

  <section id="video-library" class="scroll-mt-24">
    <h2>동영상 모음</h2>
    <p>
      사이트 곳곳에 있는 동영상을 한곳에 모았습니다. 설명을 읽고 필요한 영상을 바로 확인하실 수 있습니다.
    </p>
    <div class="not-prose mt-5 grid gap-5">
      {VIDEO_RESOURCES.map(video => (
        <article class="overflow-hidden rounded-card border border-line-soft bg-white shadow-soft md:grid md:grid-cols-[minmax(0,1.1fr)_minmax(16rem,0.9fr)]">
          <video
            class="block w-full aspect-video bg-ink-950"
            controls
            preload="metadata"
            playsinline
            aria-label={video.title.ko}
          >
            <source src={video.videoSrc} type="video/mp4" />
            <track kind="subtitles" src={video.captionSrc} srclang="en" label="English" />
            Your browser does not support the video tag.
          </video>
          <div class="flex flex-col justify-center px-5 py-4">
            <h3 class="font-heading text-lg font-semibold leading-snug text-ink-900">{video.title.ko}</h3>
            <p class="mt-2 text-base leading-relaxed text-ink-600">{video.description.ko}</p>
            <a href={lp(video.sourcePath)} class="mt-4 inline-flex text-base font-medium text-primary-700 hover:text-primary-800 hover:underline">
              관련 페이지 보기
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  {catOrder.map(catKey => {
    const cat = d.categories[catKey];
    const styles = categoryStyles[catKey];
    return (
      <section id={catAnchors[catKey]} class="scroll-mt-24">
        <h2 class:list={['not-prose flex items-center gap-3 rounded-card border px-4 py-3', styles.heading]}>
          <span class:list={['h-2.5 w-2.5 rounded-full', styles.dot]} aria-hidden="true"></span>
          {cat.title}
        </h2>
        <div class="not-prose mt-5 space-y-3">
          {Object.values(cat.items).map(item => (
            <details class:list={['group rounded-card border shadow-soft overflow-hidden', styles.details]}>
              <summary
                class:list={[
                  'flex items-center justify-between gap-4 px-5 py-4 cursor-pointer font-body font-semibold transition-colors duration-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary-500',
                  styles.summary,
                ]}
              >
                <span class="text-base leading-snug">{item.q}</span>
                <svg
                  class:list={['w-5 h-5 flex-shrink-0 transition-transform duration-200 group-open:rotate-180', styles.icon]}
                  fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
              </summary>
              <div class:list={['px-5 pb-5 pt-4 border-t', styles.panel]}>
                <p class="text-ink-700 text-base leading-relaxed font-prose">{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </section>
    );
  })}
</LongFormLayout>
