---
import LongFormLayout from '../../layouts/LongFormLayout.astro';
import PageSidebar from '../../components/layout/PageSidebar.astro';
import Icon from '../../components/ui/Icon.astro';
import { localizedPath } from '../../i18n/utils';
import { CONTACT } from '../../data/site-config';
import koData from '../../i18n/ko.json';

const lang = 'ko' as const;
const lp = (p: string) => localizedPath(p, lang);
const d = koData.hipaaNotice;
const s = d.sections;
const common = koData.common;

const anchors = [
  { id: 'about',           label: '본 고지에 대하여' },
  { id: 'uses',            label: '정보 사용 및 공유 방법' },
  { id: 'authorization',   label: '동의가 필요한 사용' },
  { id: 'rights',          label: '귀하의 권리' },
  { id: 'responsibilities',label: '당사의 책임' },
  { id: 'complaints',      label: '민원 제기' },
  { id: 'changes',         label: '고지 변경' },
  { id: 'contact',         label: '문의하기' },
];
const relatedLinks = [
  { href: '/privacy',      label: common.relatedPages.links.privacy },
  { href: '/hospice-laws', label: common.relatedPages.links.hospiceLaws },
  { href: '/contact',      label: common.relatedPages.links.contact },
];
---

<LongFormLayout
  title={d.pageTitle}
  description={d.metaDescription}
  lang={lang}
  path="/hipaa-notice"
  eyebrow="HIPAA"
  introParagraph={d.introParagraph}
  lastReviewed={d.lastReviewed}
  noIndex={false}
>
  <PageSidebar slot="sidebar" {anchors} {relatedLinks} {lang} />

  <section id="about" class="scroll-mt-24">
    <h2>{s.overview.title}</h2>
    <p>{s.overview.body}</p>
  </section>

  <section id="uses" class="scroll-mt-24">
    <h2>{s.uses.title}</h2>
    <p>{s.uses.intro}</p>
    <div class="not-prose mt-4 space-y-4">
      {s.uses.items.map(item => (
        <div class="rounded-card border border-line-soft bg-white p-5 shadow-soft">
          <h3 class="font-heading text-base text-ink-900 mb-1">{item.title}</h3>
          <p class="text-base text-ink-600 leading-relaxed">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="authorization" class="scroll-mt-24">
    <h2>{s.authorizationRequired.title}</h2>
    <p>{s.authorizationRequired.body}</p>
  </section>

  <section id="rights" class="scroll-mt-24">
    <h2>{s.rights.title}</h2>
    <p>{s.rights.intro}</p>
    <div class="not-prose mt-4 space-y-4">
      {s.rights.items.map(item => (
        <div class="rounded-card border border-line-soft bg-white p-5 shadow-soft">
          <h3 class="font-heading text-base text-ink-900 mb-1">{item.title}</h3>
          <p class="text-base text-ink-600 leading-relaxed">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="responsibilities" class="scroll-mt-24">
    <h2>{s.responsibilities.title}</h2>
    <p>{s.responsibilities.body}</p>
  </section>

  <section id="complaints" class="scroll-mt-24">
    <h2>{s.complaints.title}</h2>
    <p>{s.complaints.body}</p>
    <p>{s.complaints.hhsBody}</p>
  </section>

  <section id="changes" class="scroll-mt-24">
    <h2>{s.changes.title}</h2>
    <p>{s.changes.body}</p>
    <p class="text-sm text-ink-500 mt-2">{s.effectiveDate.body}</p>
  </section>

  <section id="contact" class="scroll-mt-24">
    <h2>{s.contact.title}</h2>
    <p>{s.contact.body}</p>
    <div class="not-prose mt-4 space-y-3">
      <a href={`mailto:${s.contact.email}`}
        class="flex items-center gap-3 text-ink-700 hover:text-primary-600 transition-colors duration-100
               focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded-sm">
        <Icon name="mail" class="w-5 h-5 text-primary-600 flex-shrink-0" />
        <span class="text-base">{s.contact.emailLabel}: {s.contact.email}</span>
      </a>
      <a href={`tel:${CONTACT.phone.tel}`}
        class="flex items-center gap-3 text-ink-700 hover:text-primary-600 transition-colors duration-100
               focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded-sm">
        <Icon name="phone" class="w-5 h-5 text-primary-600 flex-shrink-0" />
        <span class="text-base">{s.contact.phoneLabel}: {CONTACT.phone.display}</span>
      </a>
    </div>
  </section>
</LongFormLayout>
