---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';
import LocalBusinessJsonLd from '../components/seo/LocalBusinessJsonLd.astro';
import OrganizationJsonLd from '../components/seo/OrganizationJsonLd.astro';
import Hero from '../components/home/Hero.astro';
import QuickActionBar from '../components/home/QuickActionBar.astro';
import WhatToExpect from '../components/home/WhatToExpect.astro';
import ServicesSnapshot from '../components/home/ServicesSnapshot.astro';
import TrustBand from '../components/home/TrustBand.astro';
import FamilyQuote from '../components/home/FamilyQuote.astro';
import FinalCta from '../components/home/FinalCta.astro';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<BaseLayout
  title={t('home.pageTitle')}
  description={t('home.metaDescription')}
  lang={lang}
  path="/"
>
  <LocalBusinessJsonLd lang={lang} />
  <OrganizationJsonLd />

  <Hero lang={lang} />
  <QuickActionBar lang={lang} />
  <WhatToExpect lang={lang} />
  <ServicesSnapshot lang={lang} />
  <TrustBand lang={lang} />
  <FamilyQuote lang={lang} />
  <FinalCta lang={lang} />
</BaseLayout>
